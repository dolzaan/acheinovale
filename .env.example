# Postgres do Supabase — transaction pooler (porta 6543) para Vercel/Prisma.
POSTGRES_PRISMA_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=2&pool_timeout=20&connect_timeout=10"

# O aplicativo aplica estes limites ao pooler da porta 6543, mesmo quando a URL
# hospedada ainda contém valores antigos. Ajuste somente após medir em produção.
PRISMA_CONNECTION_LIMIT="2"
PRISMA_POOL_TIMEOUT="20"
PRISMA_CONNECT_TIMEOUT="10"

# Conexão direta ou session pooler (porta 5432) para migrations.
POSTGRES_URL_NON_POOLING="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Project URL e Publishable key podem ser expostas ao navegador.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Nunca exponha nem prefixe esta chave com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_..."

# Client ID público do Google Identity Services (não é o Client Secret).
NEXT_PUBLIC_GOOGLE_CLIENT_ID="000000000000-example.apps.googleusercontent.com"

# Usado apenas por ferramentas locais opcionais.
SUPABASE_PROJECT_REF="PROJECT_REF"

# Segredo enviado pela Vercel aos crons de /api/cron/ (Authorization: Bearer ...).
CRON_SECRET="gere-um-valor-aleatorio-longo"

# SMTP para e-mails (aprovação, lembretes, alertas e avisos ao admin). Sem estes valores,
# nenhum e-mail é enviado e o site continua funcionando.
SMTP_HOST="smtp.exemplo.com"
SMTP_PORT="587"
SMTP_USER="avisos@acheinovale.com.br"
SMTP_PASS="senha-ou-chave-de-app"
# Opcional: "true" para TLS direto (porta 465). Padrão: automático pela porta.
SMTP_SECURE=""
EMAIL_FROM="Achei no Vale <avisos@acheinovale.com.br>"
